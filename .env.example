# Copia este archivo como .env (local) o configura estas variables en Vercel.
# NUNCA subas el .env real al repositorio.

# --- Base de datos (Supabase) ---
# URL del proyecto Supabase
SUPABASE_URL=https://giufhhgbaurzuhzrjmmc.supabase.co
# Clave service_role (Supabase → Settings → API → service_role). Es secreta, solo va en el servidor.
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_tu_service_role_key
# (opcional) nombre de la tabla; por defecto avanzzaos_state
# AVZ_TABLE=avanzzaos_state

# --- Acceso / usuarios ---
# Usuarios y contraseñas, separados por coma. Formato "Nombre:contraseña".
APP_USERS=Sebastián:cambia_esto,Ramón:cambia_esto,Mariana:cambia_esto
# Secreto para firmar las cookies de sesión (cadena larga y aleatoria).
APP_SECRET=cadena_larga_y_aleatoria_cambia_esto
